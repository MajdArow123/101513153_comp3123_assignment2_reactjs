# Copy this file to .env for local development.
#
# IMPORTANT: every variable starting with VITE_ is built into the JavaScript bundle and is
# visible to anyone who opens the app in a browser. Never put secrets (JWT secret, database
# URI, passwords, API keys) here.

# Backend origin AS THE BROWSER SEES IT (no trailing slash, no /api/v1).
# Locally and with Docker Compose this is http://localhost:5000.
VITE_API_URL=http://localhost:5000
