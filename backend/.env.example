# Copy this file to .env and replace the placeholder values.
# Never commit your real .env file.
# When running with Docker Compose, MONGODB_URI, DB_NAME, PORT, CORS_ORIGIN and NODE_ENV
# are overridden in docker-compose.yml; JWT_SECRET and the other values come from here.

# Port the API listens on
PORT=5000
# "production" hides debug details (stack traces) from error responses
NODE_ENV=development

# MongoDB connection string (required).
# Local MongoDB:  mongodb://localhost:27017/comp3123_assignment2
# MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/comp3123_assignment2
# Database name. The assignment requires exactly comp3123_assignment2 (also the default).
DB_NAME=comp3123_assignment2

# Secret used to sign JWTs (required). Use a long random string, e.g. generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# How long a login token stays valid (e.g. 1h, 30m)
JWT_EXPIRES_IN=1h

# Frontend origin(s) allowed to call the API (required).
# Comma-separated list for several, e.g. http://localhost:3000,http://127.0.0.1:3000
# A wildcard (*) is refused at startup.
CORS_ORIGIN=http://localhost:3000

# Maximum profile picture size in MB
UPLOAD_MAX_MB=2

# Strict limit for /signup and /login (requests per IP per window)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MIN=15

# General limit for all /api routes (requests per IP per window)
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MIN=15
